<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_const"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8DC84A"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/group_2250"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

    </LinearLayout>

    <TextView
        android:id="@+id/carculator_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginBottom="17dp"
        android:text="정가 계산기"
        android:textSize="22sp"
        android:textColor="#313131"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/carculator_background"
        app:layout_constraintStart_toStartOf="parent">
    </TextView>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/carculator_background"
        android:layout_width="340dp"
        android:layout_height="459dp"
        android:layout_marginTop="143dp"
        android:background="@drawable/home_roundable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cal_insert"
            android:layout_width="293dp"
            android:layout_height="112dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>