<?xml version="1.0" encoding="utf-8"?>
<!--
    그룹 추가 다이얼로그
    - 흰 카드 + 라임 X 버튼 + 라임 외곽선 EditText + 라임 추가 버튼
    - GroupListFragment.addNewGroup() 에서 표시 (ID 유지로 Java 코드 변경 없음)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_card_bg"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp">

    <!-- 상단 헤더: "그룹명" 제목 + 우측 X 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="그룹명"
            android:textColor="#222222"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/close_group_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/dialog_close_button"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:contentDescription="닫기"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 입력창 (라임 외곽선 + 연한 라임 배경 + 둥근 모서리) -->
    <LinearLayout
        android:id="@+id/groupname_container_linear"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/dialog_group_bg"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/groupname_edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:ems="10"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1"
            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
            android:textColor="#222222"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 에러/안내 메시지 (회색, 부드러운 톤) -->
    <TextView
        android:id="@+id/group_name_error_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="invisible"
        android:text="이미 존재하는 이름입니다." />

    <!-- 우측 하단 라임 그린 "추가" 버튼 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/add_group_btn"
        android:layout_width="76dp"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#8DC84A"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="추가"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
