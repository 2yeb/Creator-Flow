<?xml version="1.0" encoding="utf-8"?>
<!--
    프로젝트 삭제 확인 다이얼로그 (커스텀)
    - 흰 카드 배경 + 라임 그린 X / 확인 버튼
    - ProjectPageFragment.confirmAndDeleteProject() 에서 표시
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp">

    <!-- 우측 상단 X 버튼 (라임 원형) -->
    <ImageView
        android:id="@+id/btn_dialog_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/dialog_close_button"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        android:contentDescription="닫기"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 제목 (Bold, 큰 글씨) -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="프로젝트를\n삭제하시겠습니까?"
        android:textColor="#222222"
        android:textSize="19sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_dialog_close" />

    <!-- 부제 (회색, 작은 글씨) -->
    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="영구적으로 삭제됩니다."
        android:textColor="#888888"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 우측 하단 라임 그린 확인 버튼 -->
    <TextView
        android:id="@+id/btn_dialog_confirm"
        android:layout_width="76dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/dialog_confirm_button_bg"
        android:gravity="center"
        android:text="확인"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_subtitle"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
