<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".SimulationBusinessFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="80dp"
            android:paddingBottom="40dp">

            <!-- ===== Group 1: 굿즈 유형 / 옵션 / 수량 / 배송 관리 ===== -->
            <LinearLayout
                style="@style/SummaryGroup">

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_goods_type" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_option" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_quantity" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_delivery_management" />
            </LinearLayout>

            <!-- ===== Group 2: 제작 업체 / 판매 업체 ===== -->
            <LinearLayout
                style="@style/SummaryGroup">

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_vendor" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_platform" />
            </LinearLayout>

            <!-- ===== Group 3: 택배 / 배송비 / 포장재 ===== -->
            <LinearLayout
                style="@style/SummaryGroup">

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_delivery_method" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_shipping_fee" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_packaging" />
            </LinearLayout>

            <!-- ===== Group 4: 입력값 (Business 시 4개, Fan-art 시 하단 2개만) ===== -->
            <LinearLayout
                style="@style/SummaryGroup">

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_profit" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_margin" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_target_qty" />

                <include
                    layout="@layout/item_summary_row"
                    android:id="@+id/row_min_stock" />
            </LinearLayout>


            <!-- ===== 예상 원가 강조 ===== -->
            <LinearLayout
                android:id="@+id/row_estimated_cost_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/summary_highlight_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/summary_bullet_dot" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="예상 원가"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_estimated_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/numeric_input_bg"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:minWidth="140dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="—"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== 확인 버튼 ===== -->
            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:background="@drawable/btn_confirm_bg"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="확인"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

    <!-- 뒤로가기 (좌상단) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로" />

</FrameLayout>
