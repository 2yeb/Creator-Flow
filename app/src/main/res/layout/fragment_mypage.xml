<?xml version="1.0" encoding="utf-8"?>
<!--
  마이페이지 화면.
  - 상단: background_back (공장/도시 silhouette + cream 배경)
  - 유저 카드: summary_group_bg (흰 배경 + lime stroke)
  - 메뉴 4개: summary_highlight_bg (lime 배경 + stroke) + summary_bullet_dot
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8DC84A"
    tools:context=".MypageFragment">

    <!-- silhouette + cream 배경 (fragment_home.xml과 동일 패턴) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:background="@drawable/background_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="180dp"
            android:paddingBottom="40dp">

            <!-- ===== 유저 카드 ===== -->
            <RelativeLayout
                android:id="@+id/user_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/summary_group_bg"
                android:clickable="true"
                android:focusable="true"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/user_profile"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/rounded_solid"
                    android:backgroundTint="@color/buttoncolor1"
                    android:contentDescription="프로필 사진"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/user_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/user_profile"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="6dp"
                    android:layout_toEndOf="@id/user_profile"
                    android:text="닉네임"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/user_nickname"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="6dp"
                    android:layout_toEndOf="@id/user_profile"
                    android:text="email@gmail.com"
                    android:textColor="#9A9A9A"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/user_card_arrow"
                    android:layout_width="10dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:contentDescription="프로필 편집"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <!-- ===== 기본 설정 ===== -->
            <LinearLayout
                android:id="@+id/menu_basic_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/summary_highlight_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/summary_bullet_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기본 설정"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== 알림 설정 ===== -->
            <LinearLayout
                android:id="@+id/menu_notification_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/summary_highlight_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/summary_bullet_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="알림 설정"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== 공지사항 ===== -->
            <LinearLayout
                android:id="@+id/menu_notices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/summary_highlight_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/summary_bullet_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="공지사항"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== 문의하기 ===== -->
            <LinearLayout
                android:id="@+id/menu_inquiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/summary_highlight_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/summary_bullet_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="문의하기"
                    android:textColor="@color/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
