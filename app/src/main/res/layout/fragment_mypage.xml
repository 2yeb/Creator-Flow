<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mypage_framge"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MypageFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_view"
        android:layout_width="382dp"
        android:layout_height="184dp"
        android:layout_marginTop="85dp"
        android:background="@drawable/mypage_user_roundable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mypage_framge">

        <ImageView
            android:id="@+id/user_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/avatar"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="25dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="19dp"/>

        <Button
            android:id="@+id/button"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:text="프로필 변경"
            android:backgroundTint="#797979"
            tools:layout_editor_absoluteX="139dp"
            tools:layout_editor_absoluteY="132dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="130dp"/>
        <LinearLayout
            android:id="@+id/user_nickname"
            android:orientation="vertical"
            android:layout_width="212dp"
            android:layout_height="33dp"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:background="@drawable/mypage_nickname"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="144dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:textSize="16sp"
                android:text="닉네임" />
        </LinearLayout>
        <TextView
            android:id="@+id/user_email"
            android:layout_width="207dp"
            android:layout_height="wrap_content"
            android:text="email@gmail.com"
            android:textSize="16sp"
            android:textColor="#737373"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginRight="26dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="81dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/mypage_lin1"
        android:layout_width="382dp"
        android:layout_height="63dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:background="@drawable/mypage_roundable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_view">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="기본 설정"
            android:textSize="22sp"
            android:textColor="#1E1E1E"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mypage_lin2"
        android:layout_width="382dp"
        android:layout_height="63dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/mypage_roundable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mypage_lin1">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:text="알림 설정"
            android:textSize="22sp"
            android:textColor="#1E1E1E"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mypage_lin3"
        android:layout_width="382dp"
        android:layout_height="63dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/mypage_roundable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mypage_lin2">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:text="공지사항 및 문의하기"
            android:textSize="22sp"
            android:textColor="#1E1E1E"
            android:textStyle="bold"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>