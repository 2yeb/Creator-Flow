<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simulation_background"
    tools:context=".SimulationDeliveryFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="80dp"
            android:paddingBottom="40dp">

            <!-- Business / Fan-art Model 헤더 (Java에서 동적 변경) -->
            <TextView
                android:id="@+id/tv_model_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Model"
                android:textColor="#7AB648"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- ===== 택배 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="택배"
                        android:textColor="@color/text_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <!-- 우체국 택배 -->
                    <LinearLayout
                        android:id="@+id/opt_post"
                        style="@style/DeliveryOptionRow">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="우체국 택배" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                    <!-- 편의점 택배 -->
                    <LinearLayout
                        android:id="@+id/opt_cvs"
                        style="@style/DeliveryOptionRow">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="편의점 택배" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                    <!-- 편의점 반값 택배 -->
                    <LinearLayout
                        android:id="@+id/opt_cvs_half"
                        style="@style/DeliveryOptionRow">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="편의점 반값 택배" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                    <!-- 방문 택배 (기사님 호출) -->
                    <LinearLayout
                        android:id="@+id/opt_visit"
                        style="@style/DeliveryOptionRow">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="방문 택배 (기사님 호출)" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                    <!-- 준등기 / 우편 -->
                    <LinearLayout
                        android:id="@+id/opt_post_mail"
                        style="@style/DeliveryOptionRowLast">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="준등기 / 우편" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 배송비 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="배송비"
                        android:textColor="@color/text_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <!-- 구매자 부담 -->
                    <LinearLayout
                        android:id="@+id/fee_buyer"
                        style="@style/DeliveryOptionRow">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="구매자 부담" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                    <!-- 구매자 부담 금액 입력 (fee_buyer 선택 시 노출) -->
                    <LinearLayout
                        android:id="@+id/fee_buyer_input_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/et_fee_buyer_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/numeric_input_bg"
                            android:hint="배송비 금액"
                            android:inputType="number"
                            android:maxLength="7"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/text_color"
                            android:textSize="14sp"
                            android:imeOptions="actionDone"
                            android:singleLine="true"
                            android:autofillHints="postalCode" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="원"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 판매자 택배 -->
                    <LinearLayout
                        android:id="@+id/fee_seller"
                        style="@style/DeliveryOptionRowLast">

                        <ImageView style="@style/DeliveryCheckIcon" />

                        <TextView
                            style="@style/DeliveryOptionText"
                            android:text="판매자 택배" />

                        <TextView style="@style/DeliveryPriceText" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 포장재 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="포장재"
                        android:textColor="@color/text_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <!-- 포장재 칩 1행: OPP 봉투 / 지퍼백 / 없음 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/pkg_opp"
                            style="@style/PackagingChip"
                            android:text="OPP 봉투" />

                        <TextView
                            android:id="@+id/pkg_zipper"
                            style="@style/PackagingChip"
                            android:layout_marginStart="8dp"
                            android:text="지퍼백" />

                        <TextView
                            android:id="@+id/pkg_none"
                            style="@style/PackagingChip"
                            android:layout_marginStart="8dp"
                            android:text="없음" />
                    </LinearLayout>

                    <!-- 포장재 칩 2행: 직접 입력 + EditText -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/pkg_custom"
                            style="@style/PackagingChip"
                            android:text="직접 입력" />

                        <EditText
                            android:id="@+id/pkg_custom_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="포장재 이름"
                            android:inputType="text"
                            android:maxLength="20"
                            android:textColor="@color/text_color"
                            android:textSize="13sp"
                            android:background="@null"
                            android:padding="0dp"
                            android:visibility="gone"
                            android:imeOptions="actionDone"
                            android:singleLine="true"
                            android:autofillHints="packaging" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 뒤로가기 (좌상단) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로" />

    <!-- 다음 화살표 (우하단, 3개 섹션 모두 선택 후 표시) -->
    <ImageView
        android:id="@+id/btn_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_arrow_right"
        android:background="@drawable/next_button_bg"
        android:padding="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="다음" />

</FrameLayout>
