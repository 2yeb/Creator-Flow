<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 바텀시트 옵션 칩 (선택 상태) -->
    <style name="VendorChipSelected">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_selected</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 바텀시트 옵션 칩 (미선택 상태) -->
    <style name="VendorChipUnselected">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_unselected</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#9A9A9A</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
